<?xml version="1.0" encoding="utf-8"?>
<!--
    صفحهٔ گزارش اشکال‌یابی.

    قابِ صفحه راست‌به‌چپ است (مثل بقیهٔ اپ)، اما *خودِ متنِ گزارش* چپ‌به‌راست نمایش
    داده می‌شود: خطوط گزارش با ساعت و برچسب لاتین شروع می‌شوند و ستون‌بندی‌شان فقط
    در چیدمان LTR درست دیده می‌شود.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/log_title"
        app:titleTextColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_muted"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_intro"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/logSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="۳۱۲ رکورد • فایل جلسه: session-1.log" />

        <!-- فقط وقتی دیده می‌شود که اجرای قبلی کرش کرده باشد. -->
        <TextView
            android:id="@+id/crashBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/log_previous_crash"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/onlyProblemsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/log_only_problems"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <!--
        گزارش می‌تواند خطوط بلند داشته باشد، پس هم پیمایش عمودی لازم است و هم افقی.
    -->
    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layoutDirection="ltr"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:scrollbars="horizontal">

            <TextView
                android:id="@+id/logText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="@dimen/screen_padding"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="11sp"
                tools:text="12:00:00.000  +0.000s  I/Env  [main]  …" />
        </HorizontalScrollView>
    </ScrollView>

    <!-- نوار عملیات؛ همیشه پایین صفحه در دسترس است. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_muted"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:alpha="0.75"
            android:text="@string/log_privacy_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveLogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_log_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareLogButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_log_share" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLogButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_log_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearLogButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_log_clear" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
