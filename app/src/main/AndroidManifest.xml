<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        هیچ مجوز اینترنتی درخواست نمی‌شود؛ اپ کاملاً آفلاین کار می‌کند.
        No INTERNET permission is declared — the app is fully offline by construction.

        برای گرفتن عکس از دوربینِ سیستم (ACTION_IMAGE_CAPTURE) نیازی به مجوز CAMERA نیست،
        چون اپِ دوربینِ خود دستگاه عکس را می‌گیرد. (اگر این مجوز اعلام شود، اندروید
        اجرای زمان-اجرا را الزامی می‌کند؛ پس عمداً اعلام نشده است.)
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- برای اینکه resolveActivity/queries در اندروید ۱۱+ اپ دوربین را ببیند -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".PersianOcrApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersianOcr">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- برای دادن URI امن به اپ دوربین و برای اشتراک‌گذاری خروجی -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
